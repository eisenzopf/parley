# Copy to `.env` on your machine. Never commit `.env`.
# GitHub Actions must not receive these values; CI uses fakes.

# PARLEY_API_SECRET=dev-only
# PARLEY_OPERATOR_BOOTSTRAP=bootstrap
# Live is the default. CI sets PARLEY_VAPI_CHAT=fake PARLEY_TUNNEL=0 PARLEY_PROVISION=0.

# VAPI_PRIVATE_KEY=
# VAPI_PUBLIC_KEY=
# VAPI_ASSISTANT_ID=
# External conference planner default, qualified separately from the saved voice assistant:
# VAPI_CHAT_MODEL=gpt-4.1

# TELNYX_TEST_API_KEY=
# TELNYX_PUBLIC_KEY=
# TELNYX_FROM_NUMBER=+14155550100
# TELNYX_MESSAGING_PROFILE_ID=

# CLOUDFLARE_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# PARLEY_HOSTNAME=parley.rudeless.ai
# PARLEY_PROVISION=1

# Conference SIP/media deployment (private values supplied locally).
# CONFERENCE_SIP_BIND=0.0.0.0:5062
# CONFERENCE_SIP_FROM=sip:demo@example.invalid
# CONFERENCE_SIP_USERNAME=
# CONFERENCE_SIP_PASSWORD=
# CONFERENCE_SIP_REALM=
# CONFERENCE_SIP_ASSERTED_IDENTITY=
# CONFERENCE_SIP_ADVERTISE=203.0.113.20:5062
# CONFERENCE_SIP_MEDIA_PUBLIC=203.0.113.20:0
# CONFERENCE_SIP_MEDIA_PORTS=44000-44200
# CONFERENCE_WEBRTC_UDP=0.0.0.0:0
# CONFERENCE_WEBRTC_PORTS=46000-46100
# CONFERENCE_WEBRTC_PUBLIC_IPS=203.0.113.20
# Server and browser ICE entries are separate. These arrays intentionally have
# no default external relay. Browser credentials are distributed to the owner.
# CONFERENCE_SERVER_ICE_JSON=[]
# CONFERENCE_BROWSER_ICE_JSON=[]
# Example ICE object: {"urls":["turn:relay.example.invalid:3478"],"username":"…","credential":"…"}
# Documentation IPs/domains above are placeholders, not working live routes.

# Live SMS requires private, operator-reviewed public-form enrollments.
# PARLEY_SMS_ENROLLMENT_PATH=/opt/parley/state/sms-enrollments.json
# PARLEY_SMS_CAMPAIGN_ID=

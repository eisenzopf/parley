+#[tokio::test]
+async fn repeated_utterance_bursts_do_not_push_rtp_seconds_ahead_of_wall_time() {
+    let (api_base, state, _observed, server) =
+        start_mock_with_behavior(Duration::ZERO, SocketBehavior::Interactive, Vec::new()).await;
+    let mut config = VapiConfig::new(VapiApiKey::new("mock-api-key").unwrap())
+        .with_api_base(api_base)
+        .with_loopback_test_transport();
+    config.heartbeat_interval = Duration::from_secs(60);
+    config.inbound_queue_capacity = 128;
+    config.jitter_target_floor_ms = 20;
+    config.jitter_target_ceiling_ms = 20;
+    config.max_catchup_frames_per_tick = 4;
+    let adapter = VapiAdapter::new(config).unwrap();
+    let request = OriginateRequest::new(
+        SessionId::new(),
+        ParticipantId::new(),
+        "vapi.websocket",
+        Direction::Outbound,
+        VapiAudioFormat::MuLaw8Khz.capabilities(),
+    )
+    .with_transport(Transport::Vapi)
+    .with_context(VapiCallOptions::new(VapiAssistant::saved("assistant-mock")));
+    let id = adapter.originate(request).await.unwrap().connection.id;
+    adapter
+        .activate_outbound_with_receipt(id.clone())
+        .await
+        .unwrap();
+    let stream = adapter.streams(id.clone()).await.unwrap().pop().unwrap();
+    let mut incoming = stream.try_frames_in().unwrap();
+    let mut first = None;
+    for _ in 0..5 {
+        // A provider utterance arrives coalesced, drains quickly, then the
+        // caller speaks. The next utterance must use the same real-time clock.
+        state
+            .injected
+            .send(Injected::Binary(vec![0x44; 20 * 160]))
+            .unwrap();
+        for index in 0..20 {
+            let frame = tokio::time::timeout(Duration::from_secs(2), incoming.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            let (start, epoch) = *first.get_or_insert((Instant::now(), frame.timestamp_rtp));
+            if index == 0 {
+                let audio_ms = frame.timestamp_rtp.wrapping_sub(epoch) as u64 / 8;
+                let wall_ms = start.elapsed().as_millis() as u64;
+                assert!(audio_ms <= wall_ms + 120,
+                    "next utterance is {audio_ms} ms on RTP but only {wall_ms} ms elapsed; catch-up plus silence double-counted time");
+            }
+        }
+        tokio::time::sleep(Duration::from_millis(450)).await;
+    }
+    adapter.end(id, EndReason::Normal).await.unwrap();
+    server.abort();
+}
